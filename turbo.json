{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".output/**", "*.tsbuildinfo"] },
    "typecheck": { "dependsOn": ["^build", "build"] },
    "@musunest/host#typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "deploy": { "dependsOn": ["build"], "cache": false }
  }
}
