{
  "spec": [
    "# R3：家庭菜園の収穫（負例：月ごとのグラフが直近 12 か月）",
    "entities:",
    "  - name: member",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 名前",
    "  - name: harvest",
    "    fields:",
    "      picker:",
    "        type: ref",
    "        to: member",
    "        label: 収穫した人",
    "      quantity:",
    "        type: number",
    "        label: 個数",
    "      pickedOn:",
    "        type: date",
    "        label: 収穫した日",
    "      crop:",
    "        type: enum",
    "        label: 作物",
    "        options:",
    "          tomato: トマト",
    "          cucumber: きゅうり",
    "          eggplant: なす",
    "computed:",
    "  - name: totalQuantity",
    "    entity: member",
    "    aggregate:",
    "      sum: harvest.quantity",
    "      where:",
    "        picker: this",
    "    type: number",
    "    label: 収穫した個数",
    "  - name: quantityThisMonth",
    "    scope: app",
    "    aggregate:",
    "      sum: harvest.quantity",
    "      where:",
    "        pickedOn:",
    "          within: this_month",
    "    type: number",
    "  - name: harvestsThisMonth",
    "    scope: app",
    "    aggregate:",
    "      count: harvest",
    "      where:",
    "        pickedOn:",
    "          within: this_month",
    "    type: number",
    "  - name: quantityByMonth",
    "    aggregate:",
    "      sum: harvest.quantity",
    "      groupBy:",
    "        month: harvest.pickedOn",
    "      last: 12",
    "    type: groups",
    "  - name: harvestsByCrop",
    "    aggregate:",
    "      count: harvest",
    "      groupBy: harvest.crop",
    "    type: groups",
    "views:",
    "  - name: dashboard",
    "    type: dashboard",
    "    widgets:",
    "      - type: number",
    "        label: 今月の収穫",
    "        value: quantityThisMonth",
    "        unit: 個",
    "      - type: number",
    "        label: 今月の件数",
    "        value: harvestsThisMonth",
    "        unit: 件",
    "      - type: bar",
    "        label: 月ごとの収穫",
    "        value: quantityByMonth",
    "        unit: 個",
    "      - type: pie",
    "        label: 作物の内訳",
    "        value: harvestsByCrop",
    "        unit: 件",
    "  - name: harvests",
    "    type: list",
    "    entity: harvest",
    "    show: [picker, quantity, pickedOn, crop]",
    "    filters: [picker, crop]",
    "  - name: members",
    "    type: table",
    "    entity: member",
    "    show: [name, totalQuantity]",
    "actions:",
    "  - name: addMember",
    "    entity: member",
    "  - name: addHarvest",
    "    entity: harvest",
    "    kind: create",
    "  - name: editHarvest",
    "    entity: harvest",
    "    kind: update",
    "  - name: deleteHarvest",
    "    entity: harvest",
    "    kind: delete",
    "validations:",
    "  - name: positiveQuantity",
    "    entity: harvest",
    "    expression: quantity >= 1",
    "    message: 個数は 1 以上にしてください",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ]
}
