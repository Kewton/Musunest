{
  "spec": [
    "# R2：マンションの共用部の点検（少ない順を、負の数の計算の順位の部品で書いた正例）",
    "entities:",
    "  - name: resident",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 名前",
    "  - name: inspection",
    "    fields:",
    "      date:",
    "        type: date",
    "        label: 日付",
    "      kind:",
    "        type: enum",
    "        label: 種類",
    "        options:",
    "          extinguisher: 消火器",
    "          lighting: 照明",
    "          exit: 非常口",
    "      assignee:",
    "        type: ref",
    "        to: resident",
    "        label: 担当",
    "      status:",
    "        type: enum",
    "        label: 状態",
    "        options:",
    "          pending: 未実施",
    "          done: 実施済み",
    "        default: pending",
    "computed:",
    "  - name: isToday",
    "    entity: inspection",
    "    type: boolean",
    "    label: 今日の点検",
    "    expression: date == today()",
    "  - name: inspectionCount",
    "    entity: resident",
    "    aggregate:",
    "      count: inspection",
    "      where:",
    "        assignee: this",
    "    type: number",
    "    label: 点検の回数",
    "  - name: fewerFirst",
    "    entity: resident",
    "    type: number",
    "    label: 少ない順の基準",
    "    expression: 0 - inspectionCount",
    "views:",
    "  - name: board",
    "    type: board",
    "    entity: inspection",
    "    columns: status",
    "    highlight: isToday",
    "  - name: inspections",
    "    type: list",
    "    entity: inspection",
    "    show: [date, kind, assignee, status]",
    "    filters: [kind, assignee]",
    "  - name: residents",
    "    type: table",
    "    entity: resident",
    "    show: [name, inspectionCount, fewerFirst]",
    "  - name: summary",
    "    type: dashboard",
    "    widgets:",
    "      - type: ranking",
    "        name: fewestInspections",
    "        label: 点検の少ない人",
    "        entity: resident",
    "        by: fewerFirst",
    "        show: [name, inspectionCount, fewerFirst]",
    "actions:",
    "  - name: addResident",
    "    entity: resident",
    "  - name: addInspection",
    "    entity: inspection",
    "    kind: create",
    "  - name: finish",
    "    entity: inspection",
    "    kind: update",
    "    set:",
    "      status: done",
    "    when: status == \"pending\"",
    "validations: []",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ],
  "log": {
    "attempts": [
      {
        "unwritable": []
      }
    ]
  }
}
