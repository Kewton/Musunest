{
  "spec": [
    "# R5：機器の修理の受付（負例：印の式が「納期当日も含む」になっている）",
    "entities:",
    "  - name: staff",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 名前",
    "  - name: device",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 機器名",
    "  - name: repair",
    "    fields:",
    "      item:",
    "        type: ref",
    "        to: device",
    "        label: 機器",
    "      assignee:",
    "        type: ref",
    "        to: staff",
    "        label: 担当",
    "      dueOn:",
    "        type: date",
    "        label: 納期",
    "      status:",
    "        type: enum",
    "        label: 状態",
    "        options:",
    "          working: 作業中",
    "          done: 完了",
    "        default: working",
    "computed:",
    "  - name: overdue",
    "    entity: repair",
    "    type: boolean",
    "    label: 納期超過",
    "    expression: dueOn <= today()",
    "  - name: repairCount",
    "    entity: device",
    "    aggregate:",
    "      count: repair",
    "      where:",
    "        item: this",
    "    type: number",
    "    label: 修理の回数",
    "  - name: assignedCount",
    "    entity: staff",
    "    aggregate:",
    "      count: repair",
    "      where:",
    "        assignee: this",
    "    type: number",
    "    label: 担当した回数",
    "views:",
    "  - name: board",
    "    type: board",
    "    entity: repair",
    "    columns: status",
    "    highlight: overdue",
    "  - name: devices",
    "    type: table",
    "    entity: device",
    "    show: [name, repairCount]",
    "  - name: staffList",
    "    type: table",
    "    entity: staff",
    "    show: [name, assignedCount]",
    "actions:",
    "  - name: addStaff",
    "    entity: staff",
    "  - name: addDevice",
    "    entity: device",
    "  - name: addRepair",
    "    entity: repair",
    "    kind: create",
    "  - name: complete",
    "    entity: repair",
    "    kind: update",
    "    set:",
    "      status: done",
    "    when: status == \"working\"",
    "validations: []",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ]
}
