{
  "spec": [
    "# R6 v2",
    "entities:",
    "  - name: observer",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 名前",
    "  - name: target",
    "    fields:",
    "      category:",
    "        type: enum",
    "        label: 種類",
    "        options:",
    "          planet: 惑星",
    "          nebula: 星雲",
    "          cluster: 星団",
    "      observerRef:",
    "        type: ref",
    "        to: observer",
    "        label: 担当の観測者",
    "      quantity:",
    "        type: number",
    "        label: 予定枚数",
    "      status:",
    "        type: enum",
    "        label: 状態",
    "        options:",
    "          pending: 未撮影",
    "          captured: 撮影済み",
    "        default: pending",
    "computed:",
    "  - name: targetCount",
    "    entity: observer",
    "    aggregate:",
    "      count: target",
    "      where:",
    "        observerRef: this",
    "    type: number",
    "    label: 担当の数",
    "views:",
    "  - name: board",
    "    type: board",
    "    entity: target",
    "    columns: status",
    "  - name: targets",
    "    type: list",
    "    entity: target",
    "    show: [category, observerRef, quantity, status]",
    "    filters: [category, observerRef]",
    "  - name: observers",
    "    type: table",
    "    entity: observer",
    "actions:",
    "  - name: addObserver",
    "    entity: observer",
    "  - name: addTarget",
    "    entity: target",
    "    kind: create",
    "  - name: markCaptured",
    "    entity: target",
    "    kind: update",
    "    set:",
    "      status: captured",
    "    when: status == \"pending\"",
    "validations:",
    "  - name: positiveQuantity",
    "    entity: target",
    "    expression: quantity >= 1",
    "    message: 予定枚数は 1 以上にしてください",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ]
}
