{
  "spec": [
    "# R1：引っ越しの荷造り（負例：数の下限を quantity > 0 で書いた。0.5 を通す）",
    "entities:",
    "  - name: member",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 名前",
    "  - name: parcel",
    "    fields:",
    "      title:",
    "        type: string",
    "        label: 荷物",
    "      category:",
    "        type: enum",
    "        label: 種類",
    "        options:",
    "          fragile: 割れ物",
    "          book: 本",
    "          clothes: 衣類",
    "      packer:",
    "        type: ref",
    "        to: member",
    "        label: 詰める人",
    "      quantity:",
    "        type: number",
    "        label: 数",
    "      status:",
    "        type: enum",
    "        label: 状態",
    "        options:",
    "          unpacked: 未梱包",
    "          packed: 梱包済み",
    "        default: unpacked",
    "computed:",
    "  - name: parcelCount",
    "    entity: member",
    "    aggregate:",
    "      count: parcel",
    "      where:",
    "        packer: this",
    "    type: number",
    "    label: 担当の数",
    "views:",
    "  - name: board",
    "    type: board",
    "    entity: parcel",
    "    columns: status",
    "  - name: parcels",
    "    type: list",
    "    entity: parcel",
    "    show: [title, category, packer, quantity, status]",
    "    filters: [category, packer]",
    "  - name: members",
    "    type: table",
    "    entity: member",
    "actions:",
    "  - name: addMember",
    "    entity: member",
    "  - name: addParcel",
    "    entity: parcel",
    "    kind: create",
    "  - name: markPacked",
    "    entity: parcel",
    "    kind: update",
    "    set:",
    "      status: packed",
    "    when: status == \"unpacked\"",
    "validations:",
    "  - name: positiveQuantity",
    "    entity: parcel",
    "    expression: quantity > 0",
    "    message: 数は 1 以上にしてください",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ]
}
