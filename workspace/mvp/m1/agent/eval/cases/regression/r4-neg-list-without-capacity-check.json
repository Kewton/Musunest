{
  "spec": [
    "# R4：ボードゲーム会の参加者（負例：定員の超過の検査が無い）",
    "entities:",
    "  - name: member",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 名前",
    "  - name: event",
    "    fields:",
    "      date:",
    "        type: date",
    "        label: 日付",
    "      venue:",
    "        type: string",
    "        label: 会場",
    "      capacity:",
    "        type: number",
    "        label: 定員",
    "      attendees:",
    "        type: list",
    "        of: member",
    "        label: 参加する人",
    "computed:",
    "  - name: attendeeCount",
    "    entity: event",
    "    expression: len(attendees)",
    "    type: number",
    "    label: 参加人数",
    "  - name: remaining",
    "    entity: event",
    "    expression: capacity - attendeeCount",
    "    type: number",
    "    label: 残り",
    "  - name: eventsJoined",
    "    entity: member",
    "    aggregate:",
    "      count: event",
    "      where:",
    "        attendees:",
    "          contains: this",
    "    type: number",
    "    label: 参加した回数",
    "views:",
    "  - name: events",
    "    type: table",
    "    entity: event",
    "    show: [date, venue, attendeeCount, capacity, remaining]",
    "  - name: members",
    "    type: table",
    "    entity: member",
    "    show: [name, eventsJoined]",
    "actions:",
    "  - name: addMember",
    "    entity: member",
    "  - name: addEvent",
    "    entity: event",
    "    kind: create",
    "  - name: editEvent",
    "    entity: event",
    "    kind: update",
    "validations:",
    "  - name: positiveCapacity",
    "    entity: event",
    "    expression: capacity >= 1",
    "    message: 定員は 1 人以上にしてください",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ],
  "log": {
    "attempts": [
      {
        "unwritable": [
          {
            "requirement": "ゲーム会は、参加する人がまだ 0 人の状態でも登録できること",
            "reason": "参照の並びは空を受け取らない"
          }
        ]
      }
    ]
  }
}
