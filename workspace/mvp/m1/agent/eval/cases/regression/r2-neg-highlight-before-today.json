{
  "spec": [
    "# R2：マンションの共用部の点検（負例：今日の印の式が「今日より前」になっている）",
    "entities:",
    "  - name: resident",
    "    fields:",
    "      name:",
    "        type: string",
    "        label: 名前",
    "  - name: inspection",
    "    fields:",
    "      date:",
    "        type: date",
    "        label: 日付",
    "      kind:",
    "        type: enum",
    "        label: 種類",
    "        options:",
    "          extinguisher: 消火器",
    "          lighting: 照明",
    "          exit: 非常口",
    "      assignee:",
    "        type: ref",
    "        to: resident",
    "        label: 担当",
    "      status:",
    "        type: enum",
    "        label: 状態",
    "        options:",
    "          pending: 未実施",
    "          done: 実施済み",
    "        default: pending",
    "computed:",
    "  - name: isToday",
    "    entity: inspection",
    "    type: boolean",
    "    label: 今日の点検",
    "    expression: date < today()",
    "  - name: inspectionCount",
    "    entity: resident",
    "    aggregate:",
    "      count: inspection",
    "      where:",
    "        assignee: this",
    "    type: number",
    "    label: 点検の回数",
    "views:",
    "  - name: board",
    "    type: board",
    "    entity: inspection",
    "    columns: status",
    "    highlight: isToday",
    "  - name: inspections",
    "    type: list",
    "    entity: inspection",
    "    show: [date, kind, assignee, status]",
    "    filters: [kind, assignee]",
    "  - name: residents",
    "    type: table",
    "    entity: resident",
    "    show: [name, inspectionCount]",
    "actions:",
    "  - name: addResident",
    "    entity: resident",
    "  - name: addInspection",
    "    entity: inspection",
    "    kind: create",
    "  - name: finish",
    "    entity: inspection",
    "    kind: update",
    "    set:",
    "      status: done",
    "    when: status == \"pending\"",
    "validations: []",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ],
  "log": {
    "attempts": [
      {
        "unwritable": [
          {
            "requirement": "メンバーごとに、担当している点検の件数（未実施のものも含めて数える）を、件数の少ない人から順に並べて見られること",
            "reason": "一覧の並べ替えが語彙に無い。順位の部品は降順だけ"
          }
        ]
      }
    ]
  }
}
