{
  "spec": [
    "# R4：ボードゲーム会の参加者（負例：別の構造で、定員の下限を capacity > 0 で書いた。0.5 を通す。申告は正しい）",
    "entities:",
    "  - name: member",
    "    fields:",
    "      name: string",
    "  - name: event",
    "    fields:",
    "      date: date",
    "      venue: string",
    "      capacity: number",
    "  - name: attendance",
    "    fields:",
    "      event:",
    "        type: ref",
    "        to: event",
    "      member:",
    "        type: ref",
    "        to: member",
    "views:",
    "  - name: eventList",
    "    type: table",
    "    entity: event",
    "    show: [date, venue, capacity, attendeeCount, remainingSlots]",
    "  - name: memberList",
    "    type: table",
    "    entity: member",
    "    show: [name, eventsJoined]",
    "  - name: attendanceList",
    "    type: table",
    "    entity: attendance",
    "    show: [event, member]",
    "actions:",
    "  - name: addMember",
    "    entity: member",
    "  - name: addEvent",
    "    entity: event",
    "  - name: addAttendance",
    "    entity: attendance",
    "validations:",
    "  - name: positiveCapacity",
    "    entity: event",
    "    expression: capacity > 0",
    "computed:",
    "  - name: attendeeCount",
    "    entity: event",
    "    type: number",
    "    aggregate:",
    "      count: attendance",
    "      where:",
    "        event: this",
    "  - name: remainingSlots",
    "    entity: event",
    "    type: number",
    "    expression: capacity - attendeeCount",
    "  - name: eventsJoined",
    "    entity: member",
    "    type: number",
    "    aggregate:",
    "      count: attendance",
    "      where:",
    "        member: this",
    "",
    "permissions:",
    "  - name: read",
    "    subject: minIdentity",
    "  - name: write",
    "    subject: minIdentity",
    "minIdentity:",
    "  mode: anonymous"
  ],
  "log": {
    "attempts": [
      {
        "unwritable": [
          {
            "requirement": "参加する人の数が定員を超えたら登録できないこと",
            "reason": "検査の式から別の entity の数を見られない"
          }
        ]
      }
    ]
  }
}
